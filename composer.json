{
  "name": "creativecrafts/laravel-sso",
  "description": "Generic OIDC and SAML 2.0 SSO for Laravel, with multi-tenant support, user provisioning, and identity linking.",
  "keywords": [
    "CreativeCrafts",
    "laravel",
    "laravel-sso",
    "OIDC",
    "SAML 2.0",
    "SSO",
    "Single sign-on"
  ],
  "homepage": "https://github.com/creativecrafts/laravel-sso",
  "license": "MIT",
  "authors": [
    {
      "name": "Godspower Oduose",
      "email": "creativecraftssolutions@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "spatie/laravel-package-tools": "^1.92",
    "illuminate/contracts": "^12.0",
    "illuminate/support": "^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.14",
    "nunomaduro/collision": "^8.8",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "rector/rector": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "CreativeCrafts\\LaravelSso\\": "src/",
      "CreativeCrafts\\LaravelSso\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CreativeCrafts\\LaravelSso\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint",
    "check-deps": "composer outdated --direct",
    "validate-composer": "composer validate --strict",
    "security-audit": "composer audit",
    "quality": [
      "@validate-composer",
      "@security-audit",
      "@analyse",
      "@test",
      "@format"
    ],
    "ci": [
      "@validate-composer",
      "@security-audit",
      "@analyse",
      "@test-coverage"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CreativeCrafts\\LaravelSso\\LaravelSsoServiceProvider"
      ],
      "aliases": {
        "LaravelSso": "CreativeCrafts\\LaravelSso\\Facades\\LaravelSso"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}